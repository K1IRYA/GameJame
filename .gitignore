# ========================================================
# Unity .gitignore (Complete & Production Ready)
# ========================================================
Tools/
# Unity directories to ignore
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
.utmp/
ExportedObj/
/UIElementsSchema/

# Never ignore .meta files for tracked assets
!/[Aa]ssets/**/*.meta

# Unity cache in Assets folder
/[Aa]ssets/[Ss]ceneDependencyCache*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Addressables
/ServerData/
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting generated files
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Blender backup files
*.blend1
*.blend1.meta

# Visual Studio / VS Code / JetBrains Rider
.vs/
.idea/
.vscode/
.consulo/
.gradle/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.pdb.meta
*.mdb
*.mdb.meta
*.opendb
*.VC.db
*.DotSettings.user

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Python generator cache (Tools)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
env/

# Unity crash reports & logs
sysinfo.txt
*.log
mono_crash.*

# Package and build artifacts
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
